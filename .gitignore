# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/backend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep templates trackable
.env
.env.local
.env.*.local
!.env.example
/backend/apps/backend/.env
/backend/apps/backend/.seed-output.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# medusa (nested backend)
/backend/.medusa
/backend/apps/backend/.medusa
