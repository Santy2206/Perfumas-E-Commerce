DATABASE_URL=postgresql://...
STORE_CORS=http://localhost:3000,https://perfumas.com.co,https://tienda.perfumas.com.co
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000,https://tienda.perfumas.com.co
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Same value as Vercel PERFUMAS_INTERNAL_SECRET (shipping hooks)
PERFUMAS_INTERNAL_SECRET=

# Customer auth — Google OAuth (email/password works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Wompi (optional locally)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Product images — S3-compatible (AWS, Cloudflare R2, Supabase Storage).
# When all of these are set, Medusa uses file-s3 instead of local static/.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FILE_URL=https://xxx.supabase.co/storage/v1/object/public/medusa
# S3_ENDPOINT=https://xxx.supabase.co/storage/v1/s3
# S3_FORCE_PATH_STYLE=true
