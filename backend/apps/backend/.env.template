# Perfumas Medusa Backend — environment
# Copy to apps/backend/.env and fill with your Supabase + secrets.

# MUST be a Postgres URI (postgresql://...), NOT https://xxxx.supabase.co
# Prefer Session pooler URI + ?uselibpqcompat=true&sslmode=require on Windows/IPv4 networks.
# Example:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
DATABASE_URL=

DB_NAME=perfumas_medusa

# Storefront :3000 locally; production = Hostinger marketing + Vercel shop subdomain
STORE_CORS=http://localhost:3000,https://perfumas.com.co,https://tienda.perfumas.com.co
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000,https://perfumas.com.co,https://tienda.perfumas.com.co

JWT_SECRET=change-me-jwt-secret
COOKIE_SECRET=change-me-cookie-secret

# Optional Redis (local docker or Upstash)
REDIS_URL=redis://localhost:6379

# Wompi (optional — storefront also reads NEXT_PUBLIC_WOMPI_PUBLIC_KEY)
WOMPI_PRIVATE_KEY=
