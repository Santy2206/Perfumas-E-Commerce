# Perfumas Next.js storefront — environment

# Local: http://localhost:3000
# Production (Hostinger marketing + shop subdomain): https://tienda.perfumas.com.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Marketing homepage (Hostinger public_html)
NEXT_PUBLIC_MARKETING_URL=https://perfumas.com.co

# Medusa backend (this repo's ./backend folder)
# Production example: https://api.perfumas.com.co
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Required when the publishable key is linked to multiple sales channels (seed links retail + wholesale)
NEXT_PUBLIC_MEDUSA_SALES_CHANNEL_ID=
NEXT_PUBLIC_MEDUSA_WHOLESALE_CHANNEL_ID=

# Customer auth (Google OAuth) — set these in backend/apps/backend/.env
# Create OAuth Client ID in Google Cloud Console; redirect URI must match:
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Same Client ID as backend GOOGLE_CLIENT_ID (needed for One Tap / Sign in aside)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Payment providers (production / sandbox)
# Public key must be NEXT_PUBLIC_ so the browser Widget can load.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Dashboard Wompi → Desarrolladores → Secretos para integración técnica
# Integrity = Widget signature; Events = webhook checksum (different values)
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
MERCADOPAGO_ACCESS_TOKEN=

# Dual-hub shipping (Fontibón / Bonanza) + ops panel
# Same secret on Vercel + Railway for /hooks/shipping/*
PERFUMAS_INTERNAL_SECRET=
OPS_PANEL_SECRET=
OPS_EMAIL=
OPS_EMAIL_FONTIBON=
OPS_EMAIL_BONANZA=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Perfumas <pedidos@perfumas.com.co>

# Picap / Pibox API (create bookings from /ops/envios — not on payment)
# Auth: query ?t=PIBOX_API_KEY  |  Base: https://turing.thetrancon.com
PIBOX_API_URL=https://turing.thetrancon.com
PIBOX_API_KEY=
PIBOX_SERVICE_TYPE_ID=5c71b03a58b9ba10fa6393cf
PIBOX_DEFAULT_SIZE_CD=1
# Hub pickup coordinates (required to create a booking)
PIBOX_FONTIBON_LAT=4.675835865260826
PIBOX_FONTIBON_LON=-74.14602466565438
PIBOX_BONANZA_LAT=4.685263790088558
PIBOX_BONANZA_LON=-74.09251012031622

# Envia.com — envíos nacionales (Ops: Crear envío Envia)
# Docs: https://docs.envia.com/  |  Never commit the real token
ENVIA_TOKEN=
ENVIA_API_URL=https://api.envia.com
ENVIA_QUERIES_URL=https://queries.envia.com
# Carriers to quote; cheapest rate wins. List live ones with Queries API.
ENVIA_DEFAULT_CARRIERS=coordinadora,servientrega,interrapidisimo,envia,tcc
ENVIA_ORIGIN_NAME=Perfumas
ENVIA_ORIGIN_COMPANY=Perfumas
ENVIA_ORIGIN_STREET=Calle 18 #103a-26
ENVIA_ORIGIN_CITY=Bogota
ENVIA_ORIGIN_STATE=DC
ENVIA_ORIGIN_POSTAL_CODE=110911
ENVIA_ORIGIN_PHONE=3000000000
ENVIA_ORIGIN_EMAIL=pedidos@perfumas.com.co
# Webhook URL to register in Envia (HTTPS, port 443):
# https://tienda.perfumas.com.co/api/shipping/envia/webhook

# Dev only: allow in-memory checkout if Medusa is down (never in production).
# ALLOW_LOCAL_CHECKOUT_FALLBACK=true

# NOTE: Do NOT put DATABASE_URL here.
# Supabase Postgres URI goes in: backend/apps/backend/.env
